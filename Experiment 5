4) Currency Converter

<!DOCTYPE html>
<html>
<head>
    <title>Currency Converter</title>
</head>

<body>

<h2>Currency Converter</h2>

<fieldset>

Convert

<input type="text" id="data">

<select id="from">

    <option>Indian Rupee</option>
    <option>US Dollar</option>

</select>

to

<select id="to">

    <option>US Dollar</option>
    <option>Indian Rupee</option>

</select>

<button onclick="convert()">Calculate</button>

<span id="answer"></span>

</fieldset>

<script>

function convert() {

    var amount =
        parseFloat(document.getElementById("data").value);

    var from =
        document.getElementById("from").value;

    var to =
        document.getElementById("to").value;

    var result;

    if (from == to) {

        result = amount;

    }
    else if (
        from == "Indian Rupee" &&
        to == "US Dollar"
    ) {

        result = amount * 0.015;

    }
    else {

        result = amount * 67.12;

    }

    document.getElementById("answer").innerHTML =
        result.toFixed(2);
}

</script>

</body>
</html>

5) Coin Flip 
<!DOCTYPE html>
<html>
<head>
    <title>Heads or Tails</title>
</head>

<body>

<h1>Heads or Tails?</h1>

<div>

<img src="heads.jpg"
     id="coin"
     width="200"
     height="200">

<br><br>

<button id="flip">Flip!</button>

</div>

<p>

Heads Total:
<span id="num_heads">0</span>

<br>

Tails Total:
<span id="num_tails">0</span>

</p>

<script>

var heads = 0;
var tails = 0;

document.getElementById("flip")
    .addEventListener("click", flipFunction);

function flipFunction() {

    var random =
        Math.floor(Math.random() * 2);

    if (random == 0) {

        document.getElementById("coin").src =
            "heads.jpg";

        heads++;

        document.getElementById("num_heads").innerHTML =
            heads;

    }
    else {

        document.getElementById("coin").src =
            "tails.jpg";

        tails++;

        document.getElementById("num_tails").innerHTML =
            tails;
    }
}

</script>

</body>
</html>

6) Birthday Cake Order Form

<!DOCTYPE html>
<html>
<head>
    <title>Birthday Cake Order Form</title>
</head>

<body>

<h1>Birthday Cake Order Form</h1>

<fieldset>

# of 1/2kg Cakes

<input type="text" id="small">

<br><br>

# of 1kg Cakes

<input type="text" id="medium">

<br><br>

# of 2kg Cakes

<input type="text" id="large">

<br><br>

Tip:

<label>
<input type="radio" name="tip" value="10">
10%
</label>

<label>
<input type="radio" name="tip" value="15">
15%
</label>

<label>
<input type="radio" name="tip" value="20">
20%
</label>

<br><br>

<button id="submit">
Calculate Order
</button>

</fieldset>

<p>

Cost of order:
<span id="price"></span>

</p>

<script>

document.getElementById("submit")
    .addEventListener("click", calculateOrder);

function calculateOrder() {

    var small =
        parseInt(document.getElementById("small").value) || 0;

    var medium =
        parseInt(document.getElementById("medium").value) || 0;

    var large =
        parseInt(document.getElementById("large").value) || 0;

    var tip =
        document.querySelector(
            'input[name="tip"]:checked'
        ).value;

    var total =
        (small * 100) +
        (medium * 200) +
        (large * 400);

    var tax =
        total * 0.09;

    total = total + tax;

    var tipAmount =
        total * (tip / 100);

    total = total + tipAmount;

    document.getElementById("price").innerHTML =
        "Rs. " + total.toFixed(2);
}

</script>

</body>
</html>

