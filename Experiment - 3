Responsive webpage using HTML5 and CSS3

<!DOCTYPE html>
<html>
<head>
    <title>Personal Web Page</title>

    <style>
        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family:Arial, sans-serif;
        }

        body{Responsive webpage using HTML5 and CSS3
            background:#f2f2f2;
        }

        .container{
            width:1000px;
            margin:20px auto;
            border:2px solid #999;
            background:white;
        }

        /* Header */
        .header{
            display:flex;
            align-items:center;
            justify-content:space-between;
            background:linear-gradient(to right,#9933ff,#7b1fa2);
            color:white;
            padding:20px;
        }

        .header img{
            width:120px;
            height:120px;
            border-radius:8px;
        }

        .title{
            flex:1;
            text-align:center;
        }

        .title h1{
            font-size:36px;
        }

        .title h3{
            font-size:28px;
        }

        .social{
            display:flex;
            flex-direction:column;
            gap:10px;
        }

        .social img{
            width:40px;
            height:40px;
        }

        /* Menu */

        .menu{
            display:flex;
            justify-content:space-around;
            background:#d9f2ff;
            padding:15px;
        }

        .menu a{
            text-decoration:none;
            color:black;
            font-size:20px;
            font-weight:bold;
        }

        .menu a:hover{
            color:blue;
        }

        /* About */

        .about{
            display:flex;
            align-items:center;
        }

        .text{
            width:45%;
            padding:25px;
            background:#d6ecff;
            font-size:20px;
            line-height:35px;
        }

        .banner{
            width:55%;
        }

        .banner img{
            width:100%;
            height:300px;
            object-fit:cover;
        }

        /* Skills */

        .skills{
            display:flex;
            justify-content:space-around;
            padding:25px;
            background:#eeeeee;
        }

        .skill{
            width:200px;
            text-align:center;
            background:white;
            border:1px solid gray;
            padding:15px;
        }

        .skill img{
            width:130px;
            height:130px;
        }

        .skill h2{
            margin-top:10px;
        }

        /* Family */

        .family{
            display:flex;
            justify-content:space-around;
            padding:30px;
            background:linear-gradient(to right,#0b4f8a,#1f7dbb);
            color:white;
        }

        .member{
            width:30%;
            text-align:center;
        }

        .member img{
            width:180px;
            height:180px;
            border-radius:50%;
            border:5px solid black;
        }

        .member h3{
            color:#ccff66;
            margin:15px 0;
        }

        .member p{
            line-height:25px;
        }

        /* Footer */

        footer{
            background:#f5deb3;
            text-align:center;
            padding:20px;
            font-style:italic;
        }
    </style>

</head>

