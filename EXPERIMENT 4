<!DOCTYPE html>
<html>
<head>
<title>Web Technology Lab</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, sans-serif;
}

body{
    background:#f2f2f2;
}

/* Main Container */
.container{
    width:1000px;
    margin:auto;
    border:2px solid gray;
}

/* Header */
.header{
    width:100%;
    height:180px;
    background:url("C:\Users\gubba\Downloads\images blue screen.jpg");
    background-size:full;
    position:relative;
}

.logo1{
    width:60px;
    position:absolute;
    left:20px;
    top:10px;
}

.logo2{
    width:50px;
    position:absolute;
    left:40px;
    top:40px;
}

/* Navigation */

.navbar{
    width:100%;
    background:gray;
}

.navbar ul{
    list-style:none;
    display:flex;
}

.navbar ul li{
    width:25%;
    text-align:center;
}

.navbar ul li a{
    display:block;
    padding:15px;
    text-decoration:none;
    color:black;
}

.navbar ul li:first-child{
    background:red;
}

.navbar ul li:hover{
    background:green;
}

/* Table Section */

.table-section{
    background:pink;
    padding:20px;
    display:flex;
    justify-content:center;
}

table{
    border-collapse:collapse;
    text-align:center;
}

th{
    background:green;
    color:black;
    padding:10px;
}

td{
    padding:10px;
}

tr:nth-child(odd){
    background:#adff2f;
}

tr:nth-child(even){
    background:green;
}

td img{
    width:35px;
}

/* Login Area */

.login-area{
    background:url("bg.jpg");
    background-size:cover;
    padding:40px;
    display:flex;
    justify-content:space-evenly;
}

.form-box{
    width:300px;
    background:white;
    padding:20px;
    border-radius:10px;
    box-shadow:0px 0px 10px gray;
}

.form-box h2{
    text-align:center;
    margin-bottom:20px;
}

.form-box label{
    display:block;
    margin-top:10px;
}

.form-box input{
    width:100%;
    padding:10px;
    margin-top:5px;
    background:#eee;
    border:none;
}

.form-box button{
    width:100%;
    padding:10px;
    margin-top:20px;
    background:#0d6efd;
    color:white;
    border:none;
    cursor:pointer;
}

/* Footer */

.footer{
    background:#f4d8b5;
    padding:20px;
    font-style:italic;
}

.footer p{
    margin:5px;
}

</style>

</head>

<body>

