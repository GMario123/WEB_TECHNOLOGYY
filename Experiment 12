import { useEffect, useState } from "react";
import axios from "axios";
import "./App.css";

function App() {
  const [students, setStudents] = useState([]);
  const [formData, setFormData] = useState({
    regNo: "",
    name: "",
    department: "",
    email: "",
    cgpa: ""
  });
  const [editId, setEditId] = useState(null);
  const [message, setMessage] = useState("");

  const API = "http://localhost:5000/students";

  const fetchStudents = async () => {
    try {
      const response = await axios.get(API);
      setStudents(response.data);
    } catch (error) {
      setMessage("Could not load students. Check the backend server.");
    }
  };

  useEffect(() => {
    fetchStudents();
  }, []);

  const handleChange = (event) => {
    setFormData({
      ...formData,
      [event.target.name]: event.target.value
    });
  };

  const handleSubmit = async (event) => {
    event.preventDefault();

    try {
      const data = {
        ...formData,
        cgpa: formData.cgpa === "" ? undefined : Number(formData.cgpa)
      };

      if (editId) {
        await axios.put(`${API}/${editId}`, data);
        setMessage("Student updated successfully.");
      } else {
        await axios.post(API, data);
        setMessage("Student added successfully.");
      }

      setFormData({
        regNo: "",
        name: "",
        department: "",
        email: "",
        cgpa: ""
      });

      setEditId(null);
      await fetchStudents();
    } catch (error) {
      setMessage(
        error.response?.data?.message || "Unable to save student."
      );
    }
  };

  const handleEdit = (student) => {
    setFormData({
      regNo: student.regNo,
      name: student.name,
      department: student.department,
      email: student.email || "",
      cgpa: student.cgpa ?? ""
    });

    setEditId(student._id);
    setMessage("Edit the details and click Update Student.");
  };

  const handleDelete = async (id) => {
    if (!window.confirm("Are you sure you want to delete this student?")) {
      return;
    }

    try {
      await axios.delete(`${API}/${id}`);
      setMessage("Student deleted successfully.");
      await fetchStudents();
    } catch (error) {
      setMessage("Unable to delete student.");
    }
  };

  const cancelEdit = () => {
    setEditId(null);
    setFormData({
      regNo: "",
      name: "",
      department: "",
      email: "",
      cgpa: ""
    });
    setMessage("");
  };

  return (
    <div className="app">
      <header className="page-header">
        <p className="subtitle">FULL STACK WEB APPLICATION</p>
        <h1>Student Management System</h1>
        <p>Manage student records in one place.</p>
      </header>

      <section className="form-card">
        <h2>{editId ? "Update Student" : "Add New Student"}</h2>

        <form onSubmit={handleSubmit}>
          <div className="form-grid">
            <input
              type="text"
              name="regNo"
              placeholder="Register Number"
              value={formData.regNo}
              onChange={handleChange}
              required
            />

            <input
              type="text"
              name="name"
              placeholder="Student Name"
              value={formData.name}
              onChange={handleChange}
              required
            />

            <input
              type="text"
              name="department"
              placeholder="Department"
              value={formData.department}
              onChange={handleChange}
              required
            />

            <input
              type="email"
              name="email"
              placeholder="Email Address"
              value={formData.email}
              onChange={handleChange}
            />

            <input
              type="number"
              name="cgpa"
              placeholder="CGPA (0–10)"
              min="0"
              max="10"
              step="0.01"
              value={formData.cgpa}
              onChange={handleChange}
            />
          </div>

          <div className="form-actions">
            <button type="submit" className="primary-button">
              {editId ? "Update Student" : "Add Student"}
            </button>

            {editId && (
              <button
                type="button"
                className="secondary-button"
                onClick={cancelEdit}
              >
                Cancel
              </button>
            )}
          </div>
        </form>

        {message && <p className="message">{message}</p>}
      </section>

      <section className="list-card">
        <div className="list-heading">
          <h2>Student List</h2>
          <span>{students.length} student(s)</span>
        </div>

        <div className="table-container">
          <table>
            <thead>
              <tr>
                <th>Register No.</th>
                <th>Name</th>
                <th>Department</th>
                <th>Email</th>
                <th>CGPA</th>
                <th>Actions</th>
              </tr>
            </thead>

            <tbody>
              {students.length === 0 ? (
                <tr>
                  <td colSpan="6" className="empty-state">
                    No students found. Add your first student above.
                  </td>
                </tr>
              ) : (
                students.map((student) => (
                  <tr key={student._id}>
                    <td>{student.regNo}</td>
                    <td>{student.name}</td>
                    <td>{student.department}</td>
                    <td>{student.email || "-"}</td>
                    <td>{student.cgpa ?? "-"}</td>
                    <td className="action-cell">
                      <button
                        className="edit-button"
                        onClick={() => handleEdit(student)}
                      >
                        Edit
                      </button>

                      <button
                        className="delete-button"
                        onClick={() => handleDelete(student._id)}
                      >
                        Delete
                      </button>
                    </td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>
      </section>
    </div>
  );
}

export default App;

